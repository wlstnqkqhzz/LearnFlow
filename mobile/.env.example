# /api 포함. 휴대폰과 개발 PC는 같은 네트워크를 사용합니다.
# ipconfig로 확인한 개발 PC의 LAN IPv4로 변경하세요. 실기기 localhost 사용 금지.
EXPO_PUBLIC_API_BASE_URL=http://192.168.0.9:8080/api

# 실제 Expo/EAS 프로젝트 및 앱 식별자가 있을 때만 지정합니다. 임의 값 사용 금지.
EXPO_PUBLIC_EAS_PROJECT_ID=
LEARNFLOW_ANDROID_PACKAGE=
LEARNFLOW_IOS_BUNDLE_IDENTIFIER=
# 실제 Firebase Android 설정 파일 경로 (FCM 서비스 계정 private key가 아님)
GOOGLE_SERVICES_JSON=
