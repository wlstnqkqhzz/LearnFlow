# IntelliJ
.idea/
*.iml

# Java / Spring
**/target/
*.class
*.log

# Node
**/node_modules/
**/dist/

# Generated test reports and TypeScript cache
# Keep test source files (including *.test.mjs) tracked.
coverage/
test-results/
playwright-report/
blob-report/
.nyc_output/
*.tsbuildinfo

# Frontend tool caches
.vite/
.vite-temp/
.eslintcache

# JVM crash reports and heap dumps
hs_err_pid*.log
replay_pid*.log
*.hprof

# Expo / React Native
**/.expo/
**/.expo-shared/

# Environment
.env
.env.*
!.env.example

# Spring local config
**/application-local.yml
**/application-local.yaml
**/application-local.properties
**/application-secret.yml
**/application-secret.yaml
**/application-secret.properties

# OS
.DS_Store
Thumbs.db

# Docs
# Keep the two canonical database scripts versioned; other generated docs stay ignored.
/docs/*
!/docs/LearnFlow.sql
!/docs/local-seed.sql
*.[mM][dD]

# Personal UI preview (keep automated tests tracked)
/fe/tests/admin-preview.html
/fe/tests/admin-preview.tsx

# External deployment secrets (sanitized examples are allowed)
**/application-prod-secret.*
**/application-production-secret.*
**/config/application-prod.*
**/config/application-production.*
**/google-services.json
**/GoogleService-Info.plist
**/*service-account*.json
**/*service_account*.json
**/credentials.json
*.keystore
*.jks
*.p12
*.p8
*.key
*.pem
*.mobileprovision
!*.example
