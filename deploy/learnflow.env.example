# Template only. Required blank fields must be supplied on the server.
# systemd EnvironmentFile syntax: KEY=value, no export, shell expansion or command substitution.
# Quote values with spaces/special characters according to systemd.exec; do not source this file.
SPRING_PROFILES_ACTIVE=prod
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080
TZ=UTC
APP_DATASOURCE_URL=jdbc:mysql://127.0.0.1:3306/learnflow?connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true
APP_DATASOURCE_USERNAME=learnflow_app
APP_DATASOURCE_PASSWORD=
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Optional: match the local Redis authentication configuration.
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_SSL_ENABLED=false
# Required: Base64 encoding of an operator-provided key of at least 32 bytes.
JWT_SECRET=
# Required positive durations in seconds; select the actual operational policy.
JWT_ACCESS_TOKEN_TTL_SECONDS=
JWT_REFRESH_TOKEN_TTL_SECONDS=
# Disabled for first boot; only enable after provisioning matching credentials.
PUSH_ENABLED=false
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
MOBILE_PUSH_ENABLED=false
EXPO_PUSH_ACCESS_TOKEN=
